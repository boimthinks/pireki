---
import { whatsappMessages } from '../data/whatsappMessages';

const whatsappNumber = "6282376737701";
---

<div class="fixed bottom-6 right-6 z-[9999] flex flex-col items-end gap-3 group">
  <!-- Bubble Text -->
  <div 
    id="wa-bubble" 
    class="translate-y-4 opacity-0 pointer-events-none transition-all duration-500 ease-out"
  >
    <div class="bg-white text-zinc-800 px-5 py-3 rounded-2xl shadow-2xl border border-zinc-100 max-w-[250px] relative">
      <p id="wa-message" class="text-sm font-medium leading-relaxed">
        {whatsappMessages[0]}
      </p>
      <!-- Arrow refined: positioned to point towards the WA button center -->
      <div class="absolute -bottom-2 right-6 w-4 h-4 bg-white rotate-45 border-r border-b border-zinc-200"></div>
    </div>
  </div>

  <!-- WA Button -->
  <a 
    href={`https://wa.me/${whatsappNumber}`} 
    target="_blank" 
    rel="noopener noreferrer"
    class="w-16 h-16 bg-[#25D366] hover:bg-[#128C7E] text-white rounded-full flex items-center justify-center shadow-2xl transition-all duration-300 hover:scale-110 active:scale-95 group-hover:rotate-12"
    aria-label="Chat WhatsApp"
  >
    <svg class="w-8 h-8 fill-white" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.353-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.067 2.877 1.215 3.076.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.123.57-.081 1.758-.699 2.006-1.376.248-.677.248-1.26.173-1.376-.075-.075-.27-.149-.567-.299zM12.008 0C5.393 0 .02 5.388.02 12.001c0 2.111.55 4.17 1.595 5.99L.02 24l6.148-1.613c1.73.94 3.682 1.437 5.836 1.437 6.613 0 11.985-5.388 11.985-12.001S18.62 0 12.008 0zM12.008 21.82c-1.792 0-3.546-.482-5.077-1.396l-.364-.218-3.774.99 1.008-3.676-.239-.38A9.951 9.951 0 012.031 12c0-5.503 4.478-9.976 9.977-9.976s9.976 4.473 9.976 9.976c0 5.503-4.478 9.976-9.976 9.976z"/>
    </svg>
  </a>
</div>

<script>
  import { whatsappMessages } from '../data/whatsappMessages';

  function updateWAMessage() {
    const bubble = document.getElementById('wa-bubble');
    const messageEl = document.getElementById('wa-message');
    if (!bubble || !messageEl) return;

    // Get or initialize message index from localStorage
    let msgIndex = parseInt(localStorage.getItem('wa_msg_index') || '0');
    
    // Set message
    messageEl.textContent = whatsappMessages[msgIndex];

    // Show bubble with delay
    setTimeout(() => {
      bubble.classList.remove('translate-y-4', 'opacity-0', 'pointer-events-none');
      
      // Auto-hide after 5 seconds of being visible
      setTimeout(() => {
        bubble.classList.add('translate-y-4', 'opacity-0', 'pointer-events-none');
      }, 5000);

    }, 1500);

    // Update index for next page visit
    const nextIndex = (msgIndex + 1) % whatsappMessages.length;
    localStorage.setItem('wa_msg_index', nextIndex.toString());
  }

  // Run on load and after swaps (for SPA feel)
  updateWAMessage();
  document.addEventListener('astro:after-swap', updateWAMessage);
</script>
