<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.faq-item').forEach((item) => {
      const question = item.querySelector('.faq-question');
      const answer = item.querySelector('.faq-answer');
      const icon = item.querySelector('.faq-icon');
      if (!(question instanceof HTMLElement) || !(answer instanceof HTMLElement) || !(icon instanceof HTMLElement)) return;
      question.addEventListener('click', () => {
        const isOpen = question.getAttribute('aria-expanded') === 'true';
        document.querySelectorAll('.faq-item').forEach((otherItem) => {
          if (otherItem === item) return;
          const oq = otherItem.querySelector('.faq-question');
          const oa = otherItem.querySelector('.faq-answer');
          const oi = otherItem.querySelector('.faq-icon');
          if (oq instanceof HTMLElement && oa instanceof HTMLElement && oi instanceof HTMLElement) {
            oq.setAttribute('aria-expanded', 'false');
            oa.style.maxHeight = '0';
            oi.style.transform = 'rotate(0deg)';
          }
        });
        question.setAttribute('aria-expanded', String(!isOpen));
        if (isOpen) {
          answer.style.maxHeight = '0';
          icon.style.transform = 'rotate(0deg)';
        } else {
          answer.style.maxHeight = answer.scrollHeight + 32 + 'px';
          icon.style.transform = 'rotate(180deg)';
        }
      });
    });
  });
</script>
