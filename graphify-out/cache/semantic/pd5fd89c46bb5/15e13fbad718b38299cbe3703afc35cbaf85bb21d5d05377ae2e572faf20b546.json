{"nodes": [{"id": "src_content_insights_aturan_persona", "label": "Persona Penulis AI Agent Pireki", "file_type": "document", "source_file": "src/content/insights/aturan/persona.md", "source_location": "whole file", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_insights_aturan_persona_google_ai_optimization_guide", "label": "Google AI Optimization Guide (2026)", "file_type": "rationale", "source_file": "src/content/insights/aturan/persona.md", "source_location": "section 6.0 and 7.4", "source_url": "https://developers.google.com/search/docs/fundamentals/ai-optimization-guide", "captured_at": null, "author": null, "contributor": null, "rationale": "Google states SEO remains relevant but only non-commodity, people-first, unique-POV content gets cited by AI Overviews; AEO/GEO tactics (llms.txt, chunking, AI-specific rewriting, inauthentic mentions) are unproven. This guide is the strategic basis for the entire content workflow."}, {"id": "src_content_insights_aturan_persona_non_commodity_content", "label": "Prinsip Non-Komoditas & People-First", "file_type": "rationale", "source_file": "src/content/insights/aturan/persona.md", "source_location": "section 6.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google AI Overviews/RAG only cites non-commodity content with a unique angle; commodity content (generic, reworded) is not cited. Hence write for humans not AI, avoid llms.txt/chunking/AI-specific rewriting, include specific data and first-hand experience."}, {"id": "src_content_insights_aturan_persona_cv_pireki_asia", "label": "CV Pireki Asia", "file_type": "concept", "source_file": "src/content/insights/aturan/persona.md", "source_location": "section 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The company writes as the actual manufacturer (not reseller or external reviewer) to establish authority and E-E-A-T; founded 2008, self-production since 2011, 1000+ projects installed."}, {"id": "src_content_insights_aturan_persona_sorepa_pro", "label": "SOREPA Pro (Sound Reduce Partition)", "file_type": "concept", "source_file": "src/content/insights/aturan/persona.md", "source_location": "section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flagship premium product; mechanical jack inside the partition for maximum sound dampening (up to 60 dB) and no bottom rail for a clean elegant look \u2014 design decisions that justify premium positioning for ballrooms and corporate meeting rooms."}, {"id": "src_content_insights_aturan_persona_sorepa_prima", "label": "Sorepa Prima", "file_type": "concept", "source_file": "src/content/insights/aturan/persona.md", "source_location": "section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_insights_aturan_persona_sorepa_redam", "label": "Sorepa Redam / Sorepa ST-100", "file_type": "concept", "source_file": "src/content/insights/aturan/persona.md", "source_location": "section 3.3 comparison table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_insights_aturan_persona_samowa_persection", "label": "Samowa Persection (Standard Movable Wall)", "file_type": "concept", "source_file": "src/content/insights/aturan/persona.md", "source_location": "section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_content_insights_aturan_persona_samowa_lipat", "label": "Samowa Lipat (Standard Movable Wall)", "file_type": "concept", "source_file": "src/content/insights/aturan/persona.md", "source_location": "section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mid-range semi-damped folding wall, most popular; lacks the Sorepa mechanical jack so dampening is inferior \u2014 a deliberate cost/quality trade-off vers