---
const { title, description, image, slug, price, sistem } = Astro.props;
---

<a href={`/tipe/${slug}`} class="reveal block group p-6 bg-white/5 rounded-2xl border border-white/10 hover:border-[#c9a84c]/50 transition-all">
  <img src={image} alt={title} class="w-full h-48 object-cover rounded-xl mb-4 group-hover:scale-[1.02] transition-transform" />
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-xl font-bold text-white">{title}</h3>
    {sistem && (
      <span class="text-xs font-bold uppercase px-3 py-1 rounded-full border {sistem === 'geser' ? 'text-[#c9a84c] border-[#c9a84c]/30 bg-[#c9a84c]/10' : 'text-blue-400 border-blue-400/30 bg-blue-400/10'}">
        {sistem}
      </span>
    )}
  </div>
  <p class="text-white/60 text-sm mb-4 line-clamp-2">{description}</p>
  <div class="text-[#c9a84c] font-bold">
    Rp. {parseInt(price).toLocaleString('id-ID')} /m²
  </div>
</a>
