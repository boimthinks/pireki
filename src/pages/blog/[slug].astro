---
import Layout from '../../layouts/Layout.astro';
import { getApiData } from '../../lib/api';
import { marked } from 'marked';
import { applyInternalLinks } from '../../lib/utils';
import CTA from '../../components/CTA.astro';
import FeaturedTipe from '../../components/FeaturedTipe.astro';
import Schema from '../../components/Schema.astro';
import BlogCard from '../../components/BlogCard.astro';
import AboutAuthor from '../../components/AboutAuthor.astro';

export async function getStaticPaths() {
  const { blog } = await getApiData();
  return blog.map(post => ({
    params: { slug: post.slug },
    props: { post, allPosts: blog },
  }));
}

const { post, allPosts } = Astro.props;

// Apply Internal Links before parsing Markdown (1 link per page)
const usedLinks = new Set<string>();
const pengantarHtml = marked.parse(post.pengantar); // No internal links here
const contentHtml = marked.parse(applyInternalLinks(post.content, usedLinks));
const kesimpulanHtml = marked.parse(post.kesimpulan); // No internal links here

// Filter related posts: same category, different slug, max 6
const relatedPosts = allPosts
  .filter(p => p.kategori === post.kategori && p.slug !== post.slug)
  .slice(0, 6);
---

<Layout title={`${post.judul_seo} - PIREKI`} description={post.pengantar} image={post.image_url}>
  <Schema type="Article" data={post} />
  <Schema type="Breadcrumb" data={[
    { name: 'Beranda', url: '/' },
    { name: 'Blog', url: '/blog' },
    { name: post.kategori, url: `/blog?cat=${post.kategori}` },
    { name: post.title, url: `/blog/${post.slug}` }
  ]} />
  <main class="py-20 bg-black text-white">
    <article class="max-w-7xl mx-auto px-6 my-10">
      {/* Breadcrumb */}
      <nav class="flex flex-wrap items-center gap-2 text-xs md:text-sm text-white/40 mb-12 overflow-hidden">
        <a href="/" class="hover:text-[#c9a84c] transition-colors whitespace-nowrap">Beranda</a>
        <span class="flex-shrink-0">/</span>
        <a href="/blog" class="hover:text-[#c9a84c] transition-colors whitespace-nowrap">Blog</a>
        <span class="flex-shrink-0">/</span>
        <span class="text-white/40 whitespace-nowrap">{post.kategori}</span>
        <span class="flex-shrink-0">/</span>
        <span class="text-[#c9a84c] font-medium truncate max-w-[150px] md:max-w-none">{post.title}</span>
      </nav>
      
      {/* SEO Title & Image */}
      <header class="max-w-4xl mx-auto text-center mb-16">
        <h1 class="text-4xl md:text-6xl font-bold mb-8 text-white">{post.judul_seo}</h1>
        <div class="aspect-video rounded-3xl overflow-hidden mb-12 border border-white/10 shadow-2xl">
          <img src={post.image_url} alt={post.title} class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
        </div>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
        <div class="lg:col-span-8">
          <div class="flex items-center gap-4 mb-6">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#c9a84c]/30 bg-[#c9a84c]/10 backdrop-blur-sm">
              <span class="text-[#c9a84c] text-xs font-bold tracking-widest uppercase">{post.kategori}</span>
            </div>
            <span class="text-white/40 text-sm">{post.date.substring(0, 10)}</span>
          </div>
          <h1 class="text-4xl md:text-7xl font-bold mb-8 text-white leading-[1.1]">
            {post.title}
          </h1>
          <div class="text-lg text-white/60 leading-relaxed mb-10 italic border-l-4 border-[#c9a84c] pl-6 py-2 prose-gold" set:html={pengantarHtml} />
          
          <CTA />
          
          <h3 class="text-2xl font-bold text-[#c9a84c] mt-16 mb-8">Pilihan Partisi Terbaik</h3>
          <FeaturedTipe />

          <div class="prose-content prose-gold mt-16" set:html={contentHtml} />

          <div class="mt-16 p-10 rounded-3xl bg-white/5 border border-white/10 relative overflow-hidden group">
            <h3 class="text-2xl font-bold mb-6 text-white flex items-center gap-3">
              <span class="text-[#c9a84c]">#</span> Kesimpulan
            </h3>
            <div class="text-white/70 text-base leading-relaxed prose-gold" set:html={kesimpulanHtml} />
          </div>

          <AboutAuthor />

          {relatedPosts.length > 0 && (
            <section class="mt-20">
              <h3 class="text-2xl font-bold text-white mb-10">Artikel Terkait</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {relatedPosts.map(rp => (
                  <BlogCard 
                    title={rp.title} 
                    description={rp.pengantar} 
                    image={rp.image_url} 
                    slug={rp.slug} 
                    kategori={rp.kategori} 
                  />
                ))}
              </div>
            </section>
          )}
        </div>

        {/* Sidebar */}
        <div class="lg:col-span-4">
          <div class="sticky top-28 space-y-8">
            <div class="bg-[#c9a84c] p-8 rounded-3xl text-black shadow-xl">
              <h3 class="text-2xl font-bold mb-4">Butuh Solusi Partisi?</h3>
              <p class="text-black/80 text-sm mb-8 leading-relaxed">
                Konsultasikan kebutuhan partisi ruangan Anda dengan tim ahli kami secara gratis.
              </p>
              <a href="https://wa.me/6282376737701" target="_blank" class="flex items-center justify-center gap-3 w-full py-4 bg-black text-white font-bold rounded-2xl hover:bg-zinc-900 transition-colors">
                Hubungi WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  /* Local overrides if any, otherwise can be empty or removed if no other styles */
</style>
