---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import Schema from '../../components/Schema.astro';

export async function getStaticPaths() {
  const tipeEntries = await getCollection('tipe');
  return tipeEntries.map(entry => ({
    params: { slug: entry.data.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Format H1 based on system type
const systemName = entry.data.sistem === 'lipat' ? 'Partisi Lipat' : 'Partisi Geser';
const seoH1 = `${systemName} Tipe ${entry.data.title}`;
---

<Layout title={`${seoH1} - PIREKI`} description={entry.data.description} image={entry.data.featured_image}>
  <Schema type="Product" data={{
    title: seoH1,
    featured_image: entry.data.featured_image,
    description: entry.data.description,
    price: entry.data.price,
    ratingValue: "4.8",
    reviewCount: "127"
  }} />
  <Schema type="Breadcrumb" data={[
    { name: 'Beranda', url: '/' },
    { name: 'Tipe Partisi', url: '/tipe' },
    { name: entry.data.title, url: `/tipe/${entry.data.slug}` }
  ]} />
  <Schema type="WebSite" />
  <Schema type="ImageObject" data={{ contentUrl: entry.data.featured_image }} />
  <main class="bg-black">
    {/* Hero Section */}
    <section class="relative pt-32 pb-20 overflow-hidden border-b border-white/5">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/80 to-black z-10"></div>
        <img src={entry.data.featured_image} alt={entry.data.title} class="w-full h-full object-cover opacity-40 blur-sm scale-105" />
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-6">
        <nav class="flex flex-wrap items-center gap-2 text-xs md:text-sm text-white/40 mb-12 overflow-hidden">
          <a href="/" class="hover:text-[#c9a84c] transition-colors whitespace-nowrap">Beranda</a>
          <span class="flex-shrink-0">/</span>
          <a href="/tipe" class="hover:text-[#c9a84c] transition-colors whitespace-nowrap">Tipe Partisi</a>
          <span class="flex-shrink-0">/</span>
          <span class="text-[#c9a84c] font-medium truncate max-w-[150px] md:max-w-none">{entry.data.title}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full border border-[#c9a84c]/30 bg-[#c9a84c]/10 backdrop-blur-sm">
              <span class="text-[#c9a84c] text-xs font-bold tracking-widest uppercase">Produk Unggulan</span>
            </div>
            <h1 class="text-4xl md:text-7xl font-bold mb-8 text-white leading-[1.1]">
              {seoH1}
            </h1>
            <p class="text-lg text-white/70 leading-relaxed mb-10 max-w-xl">
              {entry.data.description}
            </p>
            <div class="flex items-end gap-4 mb-10">
              <div>
                <p class="text-white/40 text-xs uppercase tracking-widest mb-1">Mulai Dari</p>
                <p class="text-3xl md:text-4xl text-[#c9a84c] font-bold">Rp. {parseInt(entry.data.price).toLocaleString('id-ID')} <span class="text-sm font-normal text-white/40">/m²</span></p>
              </div>
            </div>
            <a href="https://wa.me/6282376737701" target="_blank" class="inline-flex items-center gap-3 px-8 py-4 bg-[#c9a84c] text-black font-bold rounded-2xl hover:scale-105 transition-transform shadow-xl shadow-[#c9a84c]/20">
              Konsultasi Harga Sekarang
            </a>
          </div>
          <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-[#c9a84c] to-[#e5c158] rounded-3xl blur opacity-20 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
            <img src={entry.data.featured_image} alt={entry.data.title} class="relative w-full aspect-[4/3] object-cover rounded-3xl border border-white/10 shadow-2xl" />
          </div>
        </div>
      </div>
    </section>

    {/* Content Section */}
    <section class="py-24 max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
        {/* Main Article */}
        <div class="lg:col-span-8">
          <div class="bg-white/5 p-8 md:p-12 rounded-3xl border border-white/10 mb-12">
            <h2 class="text-2xl font-bold mb-8 text-white flex items-center gap-3">
              <span class="w-8 h-1 bg-[#c9a84c] rounded-full"></span>
              Spesifikasi Teknis
            </h2>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-8">
              {entry.data.specifications.map(spec => (
                <li class="flex items-center gap-3 text-white/70 text-sm">
                  <span class="text-[#c9a84c] flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                  </span> 
                  {spec}
                </li>
              ))}
            </ul>
          </div>

          <div class="prose-content prose-gold">
            <Content />
          </div>
        </div>

        {/* Sidebar */}
        <div class="lg:col-span-4">
          <div class="sticky top-28 space-y-8">
            <div class="bg-white/5 p-8 rounded-3xl border border-white/10">
              <h3 class="text-xl font-bold mb-6">Keunggulan Tipe Ini</h3>
              <ul class="space-y-4">
                <li class="flex items-start gap-3 text-white/60 text-sm">
                  <span class="text-[#c9a84c] mt-1">✓</span>
                  Solusi efektif untuk pembagi ruangan.
                </li>
                <li class="flex items-start gap-3 text-white/60 text-sm">
                  <span class="text-[#c9a84c] mt-1">✓</span>
                  Material tahan lama dengan perawatan minimal.
                </li>
                <li class="flex items-start gap-3 text-white/60 text-sm">
                  <span class="text-[#c9a84c] mt-1">✓</span>
                  Pilihan finishing yang beragam (HPL, Wallpaper, Kain).
                </li>
                <li class="flex items-start gap-3 text-white/60 text-sm">
                  <span class="text-[#c9a84c] mt-1">✓</span>
                  Sistem operasional yang ringan dan lancar.
                </li>
              </ul>
            </div>

            <div class="bg-gradient-to-br from-[#c9a84c] to-[#a07830] p-1 rounded-3xl">
              <div class="bg-black p-8 rounded-[1.4rem]">
                <h3 class="text-xl font-bold mb-4 text-[#c9a84c]">Pesan Sekarang</h3>
                <p class="text-white/60 text-sm mb-8 leading-relaxed">
                  Dapatkan estimasi biaya gratis dan survey lokasi untuk pemasangan <strong>{entry.data.title}</strong> Anda.
                </p>
                <a href="https://wa.me/6282376737701" target="_blank" class="block w-full py-4 bg-[#c9a84c] text-black text-center font-bold rounded-2xl hover:bg-[#b8953d] transition-colors shadow-lg shadow-[#c9a84c]/20">
                  Chat via WhatsApp
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTA />
  </main>
</Layout>

<style is:global>
  /* Local overrides can be added here */
</style>
