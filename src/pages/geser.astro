---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import CTA from '../components/CTA.astro';

const faqData = [
  {
    question: "Apa perbedaan Sorepa Pro dengan Sorepa biasa?",
    answer: "Sorepa Pro adalah varian premium dengan peredaman suara hingga 60 dB, menggunakan jack mekanik penuh di setiap panel, serta sistem sliding tanpa rel bawah untuk tampilan yang lebih bersih dan elegan. Sorepa biasa tetap memiliki peredaman suara yang baik namun dengan spesifikasi standar yang lebih terjangkau."
  },
  {
    question: "Apakah partisi geser bisa dipasang di lantai yang tidak rata?",
    answer: "Ya, partisi geser Pireki dirancang dengan sistem rel atas yang fleksibel sehingga dapat menyesuaikan dengan kondisi lantai yang tidak rata sempurna. Tim teknis kami akan melakukan survey lokasi terlebih dahulu untuk memastikan pemasangan yang optimal."
  },
  {
    question: "Berapa lama proses pemasangan partisi geser?",
    answer: "Waktu pemasangan bervariasi tergantung luas area dan kompleksitas proyek. Untuk ruangan berukuran standar (50-100 m²), pemasangan biasanya selesai dalam 3-7 hari kerja oleh tim teknisi berpengalaman kami."
  },
  {
    question: "Apakah partisi geser Pireki bisa meredam suara dengan baik?",
    answer: "Tergantung tipe yang dipilih. Sorepa Pro dan Sorepa Prima mampu meredam suara hingga 60 dB, cocok untuk ballroom hotel dan ruang meeting. Sorepa standar juga memiliki peredaman yang baik dengan rockwool 60kg/m³, sementara Samowa Persection menggunakan glasswool 30kg/m³ untuk peredaman medium."
  },
  {
    question: "Apakah partisi geser memerlukan perawatan khusus?",
    answer: "Perawatan partisi geser relatif mudah. Cukup bersihkan rel secara berkala dari debu, lumasi roda geser setahun sekali, dan periksa kondisi rubber seal. Pireki juga menyediakan layanan pemeliharaan berkala untuk memastikan partisi tetap berfungsi optimal."
  },
  {
    question: "Berapa garansi untuk partisi geser Pireki?",
    answer: "Pireki memberikan garansi produk yang meliputi perbaikan dan penggantian komponen. Detail garansi akan dijelaskan saat konsultasi dan tercantum dalam kontrak kerja. Kami juga menyediakan layanan purna jual dan pemeliharaan berkala."
  }
];

const portfolioProjects = [
  { institution: "PT Petrokimia Gresik", location: "Gresik, Jawa Timur", product: "Sorepa", highlight: "BUMN pupuk terbesar — partisi geser premium untuk kantor pusat dengan isolasi suara optimal." },
  { institution: "The Rich Jogja Hotel", location: "Sleman, Yogyakarta", product: "Sorepa Stacking", highlight: "Ballroom hotel bintang 5; partisi geser dengan sistem stacking 2 roda untuk fleksibilitas ruang maksimal." },
  { institution: "FUGO Hotel Samarinda", location: "Samarinda, Kalimantan Timur", product: "Sorepa Stacking", highlight: "Ballroom serbaguna dengan partisi geser setinggi 7,6 meter — salah satu proyek tertinggi yang pernah kami kerjakan." },
  { institution: "UIN Sumatera Utara (UINSU)", location: "Medan, Sumatera Utara", product: "Sorepa", highlight: "Aula kampus dipecah menjadi beberapa ruang tanpa gangguan kebocoran suara antar ruangan." },
  { institution: "PT Pertamina Hulu Rokan", location: "Pekanbaru & Rumbai, Riau", product: "Sorepa", highlight: "Perusahaan energi nasional; 2 proyek terpisah untuk ruang rapat dan kolaborasi yang adaptif." },
  { institution: "Blue Sky Lounge — Bandara Sultan Hasanuddin", location: "Makassar, Sulawesi Selatan", product: "Sorepa", highlight: "Ruang tunggu premium bandara; meningkatkan pengalaman penumpang di gerbang Indonesia timur." },
  { institution: "Bank BNI Makassar", location: "Makassar, Sulawesi Selatan", product: "Sorepa Prima", highlight: "Kantor cabang BUMN; ruang besar disulap menjadi beberapa area pelatihan dan diskusi tim." },
  { institution: "Hunian POLRI & BIN IKN", location: "Ibu Kota Nusantara", product: "Sorepa", highlight: "Proyek strategis nasional; pemasangan di 7 tower hunian untuk optimalisasi ruang dan privasi." },
];
---

<Layout
