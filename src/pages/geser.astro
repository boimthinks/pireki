          <div class="faq-item reveal rounded-2xl border border-white/10 bg-white/5 overflow-hidden">
            <button class="faq-question w-full flex items-center justify-between p-6 text-left text-white font-bold text-base md:text-lg hover:bg-white/[0.02] transition-colors" aria-expanded="false">
              <span>{faq.question}</span>
              <svg class="faq-icon w-5 h-5 text-[#c9a84c] flex-shrink-0 ml-4 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="px-6 pb-6 text-white/70 leading-relaxed text-sm">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Schema type="FAQPage" data={faqData} />

  {/* CTA */}
  <section class="pb-24 bg-[#050505]">
    <CTA
      title="Siap Memaksimalkan Fungsi Ruangan Anda?"
      description="Tim ahli Pireki siap membantu Anda memilih tipe partisi geser yang tepat untuk proyek Anda. Konsultasi gratis — tanpa biaya, tanpa komitmen."
    />
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.faq-item').forEach((item) => {
      const question = item.querySelector('.faq-question');
      const answer = item.querySelector('.faq-answer');
      const icon = item.querySelector('.faq-icon');
      if (!(question instanceof HTMLElement) || !(answer instanceof HTMLElement) || !(icon instanceof HTMLElement)) return;
      question.addEventListener('click', () => {
        const isOpen = question.getAttribute('aria-expanded') === 'true';
        document.querySelectorAll('.faq-item').forEach((otherItem) => {
          if (otherItem === item) return;
          const oq = otherItem.querySelector('.faq-question');
          const oa = otherItem.querySelector('.faq-answer');
          const oi = otherItem.querySelector('.faq-icon');
          if (oq instanceof HTMLElement && oa instanceof HTMLElement && oi instanceof HTMLElement) {
            oq.setAttribute('aria-expanded', 'false');
            oa.style.maxHeight = '0';
            oi.style.transform = 'rotate(0deg)';
          }
        });
        question.setAttribute('aria-expanded', String(!isOpen));
        if (isOpen) {
          answer.style.maxHeight = '0';
          icon.style.transform = 'rotate(0deg)';
        } else {
          answer.style.maxHeight = answer.scrollHeight + 32 + 'px';
          icon.style.transform = 'rotate(180deg)';
        }
      });
    });
  });
</script>
